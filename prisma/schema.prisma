// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  name              String?
  createdAt         DateTime @default(now())
  gmailRefreshToken String?
  tokenVersion      Int      @default(0)

  categories     Category[]
  expenses       Expense[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  pendingImports PendingImport[]
  incomes        Income[]
  merchants      Merchant[]
  accounts       Account[]
  loans          Loan[]
}

model Category {
  id        String  @id @default(cuid())
  name      String
  icon      String?
  color     String?
  type      String  @default("EXPENSE") // ⭐ NEW: EXPENSE | SAVINGS
  isDefault Boolean @default(false)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses       Expense[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  pendingImports PendingImport[]

  @@unique([userId, name])
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @default(now())
  note        String?
  merchant    String? // ⭐ NEW
  receiptUrl  String?
  isRecurring Boolean  @default(false)
  type        String   @default("EXPENSE") // EXPENSE | SAVINGS
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(10, 2)
  period     String
  startDate  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
}

model RecurringRule {
  id            String   @id @default(cuid())
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  frequency     String
  dayOfMonth    Int?
  dayOfWeek     Int?
  nextExecution DateTime
  isActive      Boolean  @default(true)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model PendingImport {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal   @db.Decimal(10, 2)
  date       DateTime
  merchant   String
  note       String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  source     String
  sourceId   String
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Income {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String   @default("SALARY")
  amount    Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())
  note      String?
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  aliases   String[] @default([]) // ⭐ NEW
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Account {
  id          String  @id @default(cuid())
  name        String
  type        String
  institution String?
  last4       String?
  currency    String  @default("INR")
  isActive    Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses     Expense[]
  incomes      Income[]
  loans        Loan[]
  emiSchedules LoanEmiSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Loan {
  id       String  @id @default(cuid())
  name     String
  lender   String?
  loanType String  @default("HOME_LOAN")

  originalPrincipal Decimal @db.Decimal(14, 2)
  currentPrincipal  Decimal @db.Decimal(14, 2)

  // A staged-disbursement loan has an APPROVED limit that is larger than what
  // has actually been drawn. `originalPrincipal` is the sanctioned limit for
  // such a loan; `disbursedPrincipal` is the sum of the disbursement ledger and
  // is recomputed from it, never incremented.
  sanctionedLimit      Decimal? @db.Decimal(14, 2)
  disbursedPrincipal   Decimal  @default(0) @db.Decimal(14, 2)
  disbursementComplete Boolean  @default(false)

  // Construction stage: the borrower pays interest only (pre-EMI) before the
  // loan converts to full EMIs.
  preEmiActive Boolean @default(false)

  // A loan can be fully repaid on the bank's ledger and still not be formally
  // closed: SBI's statement may show a paisa outstanding and "Account Open".
  // This records that state without pretending the account is closed.
  settlementPending Boolean @default(false)

  interestRate Decimal? @db.Decimal(6, 3)
  emiAmount    Decimal? @db.Decimal(14, 2)

  startDate DateTime?
  endDate   DateTime?
  emiDay    Int?

  isActive Boolean @default(true)

  paymentAccountId String?
  paymentAccount   Account? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments LoanPayment[]

  disbursements    LoanDisbursement[]
  interestPostings LoanInterestPosting[]
  emiSchedules     LoanEmiSchedule[]
  rateChanges      LoanRateChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// One actual draw-down of the sanctioned limit.
model LoanDisbursement {
  id String @id @default(cuid())

  date      DateTime
  amount    Decimal  @db.Decimal(14, 2)
  reference String? // bank tranche / UTR reference, used for duplicate detection
  note      String?

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([loanId, reference])
  @@index([loanId])
}

/// Interest and charges the BANK posted, kept independently of repayments so a
/// statement balance can be reconciled without inventing a principal/interest
/// split on the repayment side.
model LoanInterestPosting {
  id String @id @default(cuid())

  date      DateTime
  amount    Decimal  @db.Decimal(14, 2)
  kind      String   @default("INTEREST") // INTEREST | CHARGE
  reference String?
  note      String?

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([loanId, reference])
  @@index([loanId])
}

/// A historical interest-rate change. The ORIGINAL rate is recorded as a row too,
/// so changing `Loan.interestRate` never loses the rate the loan actually ran on.
/// Rate changes are forward-looking by construction: they re-price projections
/// from `effectiveDate` and never touch a stored interest posting.
model LoanRateChange {
  id String @id @default(cuid())

  effectiveDate     DateTime
  annualRatePercent Decimal  @db.Decimal(6, 3)
  note              String?

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([loanId, effectiveDate])
  @@index([loanId])
}

/// The contractual deduction schedule. Rows are SCHEDULED only: nothing here
/// ever moves money. A row becomes CONFIRMED only when a real payment is
/// recorded against it, which is what prevents duplicate posting.
model LoanEmiSchedule {
  id String @id @default(cuid())

  sequence Int // 1-based, unique per loan
  dueDate  DateTime
  amount   Decimal  @db.Decimal(14, 2)
  kind     String   @default("EMI") // PRE_EMI | EMI

  status String @default("SCHEDULED") // SCHEDULED | CONFIRMED | STOPPED | SKIPPED

  paymentAccountId String?
  paymentAccount   Account? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)

  confirmedPaymentId String?      @unique
  confirmedPayment   LoanPayment? @relation("EmiScheduleConfirmation", fields: [confirmedPaymentId], references: [id], onDelete: SetNull)

  stoppedAt DateTime?
  note      String?

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loanId, sequence])
  @@index([loanId])
}

model LoanPayment {
  id String @id @default(cuid())

  date DateTime

  totalAmount     Decimal @db.Decimal(14, 2)
  principalAmount Decimal @db.Decimal(14, 2)
  interestAmount  Decimal @db.Decimal(14, 2)
  extraPrincipal  Decimal @default(0) @db.Decimal(14, 2)

  outstandingAfter Decimal? @db.Decimal(14, 2)

  note String?

  // Where the row came from and whether the bank's split is known. A repayment
  // whose principal/interest split is not bank-verified must not be presented as
  // if it were: `allocationVerified` is false and the UI says so.
  source             String  @default("MANUAL") // MANUAL | IMPORT | SCHEDULED
  status             String  @default("CONFIRMED") // SCHEDULED (assumed) | CONFIRMED | REJECTED
  allocationVerified Boolean @default(true)
  externalRef        String? // bank reference; the duplicate key for imports

  scheduledDate DateTime?

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  emiSchedule LoanEmiSchedule? @relation("EmiScheduleConfirmation")

  createdAt DateTime @default(now())

  @@unique([loanId, externalRef])
  @@index([loanId])
}
