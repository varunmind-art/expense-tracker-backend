// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  name              String?
  createdAt         DateTime @default(now())
  gmailRefreshToken String?

  categories     Category[]
  expenses       Expense[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  pendingImports PendingImport[]
  incomes        Income[]
  merchants      Merchant[]
  accounts       Account[]
  loans          Loan[]
}

model Category {
  id        String  @id @default(cuid())
  name      String
  icon      String?
  color     String?
  type      String  @default("EXPENSE") // ⭐ NEW: EXPENSE | SAVINGS
  isDefault Boolean @default(false)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses       Expense[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  pendingImports PendingImport[]

  @@unique([userId, name])
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @default(now())
  note        String?
  merchant    String? // ⭐ NEW
  receiptUrl  String?
  isRecurring Boolean  @default(false)
  type        String   @default("EXPENSE") // EXPENSE | SAVINGS
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(10, 2)
  period     String
  startDate  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
}

model RecurringRule {
  id            String   @id @default(cuid())
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  frequency     String
  dayOfMonth    Int?
  dayOfWeek     Int?
  nextExecution DateTime
  isActive      Boolean  @default(true)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model PendingImport {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal   @db.Decimal(10, 2)
  date       DateTime
  merchant   String
  note       String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  source     String
  sourceId   String
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Income {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String   @default("SALARY")
  amount    Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())
  note      String?
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  aliases   String[] @default([]) // ⭐ NEW
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Account {
  id          String  @id @default(cuid())
  name        String
  type        String
  institution String?
  last4       String?
  currency    String  @default("INR")
  isActive    Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses Expense[]
  incomes  Income[]
  loans    Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Loan {
  id       String  @id @default(cuid())
  name     String
  lender   String?
  loanType String  @default("HOME_LOAN")

  originalPrincipal Decimal @db.Decimal(14, 2)
  currentPrincipal  Decimal @db.Decimal(14, 2)

  interestRate Decimal? @db.Decimal(6, 3)
  emiAmount    Decimal? @db.Decimal(14, 2)

  startDate DateTime?
  endDate   DateTime?
  emiDay    Int?

  isActive Boolean @default(true)

  paymentAccountId String?
  paymentAccount   Account? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments LoanPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LoanPayment {
  id String @id @default(cuid())

  date DateTime

  totalAmount     Decimal @db.Decimal(14, 2)
  principalAmount Decimal @db.Decimal(14, 2)
  interestAmount  Decimal @db.Decimal(14, 2)
  extraPrincipal  Decimal @default(0) @db.Decimal(14, 2)

  outstandingAfter Decimal? @db.Decimal(14, 2)

  note String?

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([loanId])
}
