{
  "name": "expense-tracker-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"test/baseline/*.test.js\" \"test/p0/*.test.js\"",
    "test:db": "node --test \"test/db/*.test.js\"",
    "preflight:db": "node -e \"const{runPreflight}=require('./test/db/preflight');const r=runPreflight();console.log('PREFLIGHT OK -> dev database:',r.database);console.log('checks:',r.checks.join(' | '))\"",
    "postinstall": "prisma generate",
    "build": "prisma generate && node scripts/verify-prisma-client.js",
    "verify:client": "node scripts/verify-prisma-client.js"
  },
  "keywords": [],
  "author": "",
