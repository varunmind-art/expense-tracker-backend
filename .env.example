# Placeholder-only template. Copy to `.env` (application config) and/or
# `.env.dev` (development database), then fill in real values locally.
# NEVER commit real connection strings, passwords or secrets.
# Setup guide: docs/P0-7_NEON_DEV_SETUP.md

# Pooled connection, used by the running application.
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require"

# Unpooled (direct) connection. Needed because migrations take advisory locks,
# which do not behave correctly through a connection pooler. `directUrl` is NOT
# yet declared in prisma/schema.prisma, so pass this explicitly for migrations:
#   set -a; . ./.env.dev; set +a; export DATABASE_URL="$DIRECT_URL"
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require"

JWT_SECRET="<long-random-secret>"
EMAIL_USER="<smtp-username>"
EMAIL_APP_PASSWORD="<smtp-app-password>"
FRONTEND_URL="<frontend-origin>"
GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"
GOOGLE_REDIRECT_URI="<backend-oauth-callback-url>"
